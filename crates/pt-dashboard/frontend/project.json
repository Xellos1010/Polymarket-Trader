{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "pt-dashboard-frontend",
  "projectType": "application",
  "root": "crates/pt-dashboard/frontend",
  "sourceRoot": "crates/pt-dashboard/frontend/src",
  "tags": ["scope:dashboard", "type:ui"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "metadata": { "description": "Vite dev server with backend API proxy" },
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run dev -- --host 0.0.0.0 --port 5173"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "metadata": { "description": "Vite production build" },
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "metadata": { "description": "Vitest" },
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "metadata": { "description": "tsc --noEmit" },
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm exec tsc --noEmit -p tsconfig.json"
      }
    }
  }
}
