# Cloudflare tunnel adapter settings for the Raspberry Pi barebones install.
# Copy relevant values into the Pi-side .env.pi if you need to override defaults.
# Do not commit secrets or public URLs that are sensitive for your environment.

# Local origin exposed through cloudflared.
# Default matches the dashboard bind used by pi_dev_sync.sh.
PT_CLOUDFLARE_ORIGIN_URL=http://127.0.0.1:8080

# Operator-side mode selection:
#   auto            Prefer existing tunnel config; otherwise use anon-systemd
#   anon-systemd    Maintain a local systemd service that runs:
#                   cloudflared tunnel --url "$PT_CLOUDFLARE_ORIGIN_URL"
#   managed-service Use Cloudflare's token-installed service path
# PI_CLOUDFLARE_MODE=auto
