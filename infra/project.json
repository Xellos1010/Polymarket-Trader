{
  "name": "infra",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "infra",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./scripts/infra_render.sh build"
      }
    },
    "print": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./scripts/infra_render.sh print"
      }
    },
    "print-service": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./scripts/infra_render.sh print service"
      }
    },
    "print-cloudflare": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./scripts/infra_render.sh print cloudflare"
      }
    }
  },
  "tags": ["scope:infra", "type:config"]
}
