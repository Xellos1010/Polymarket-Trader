{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket-trader.local/schemas/config.schema.json",
  "title": "AppConfig",
  "description": "Logical schema for config/config.toml (represented as JSON). This schema covers the active Coinbase workstation shape and remains permissive for legacy local-only sections.",
  "type": "object",
  "required": ["engine", "venues", "signals", "risk", "storage", "ops"],
  "properties": {
    "engine": {
      "type": "object",
      "required": ["mode", "loop_ms"],
      "properties": {
        "mode": { "type": "string", "enum": ["replay", "paper", "live"] },
        "loop_ms": { "type": "integer", "minimum": 50 },
        "portfolio_id": { "type": ["string", "null"] },
        "replay_path": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "venues": {
      "type": "object",
      "required": ["polymarket", "coinbase"],
      "properties": {
        "polymarket": {
          "type": "object",
          "required": ["gamma_api", "data_api", "clob_api", "clob_ws", "chain_id", "filters"],
          "properties": {
            "gamma_api": { "type": "string", "pattern": "^https?://" },
            "data_api": { "type": "string", "pattern": "^https?://" },
            "clob_api": { "type": "string", "pattern": "^https?://" },
            "clob_ws": { "type": "string", "pattern": "^wss?://" },
            "private_key": { "type": ["string", "null"] },
            "use_server_time": { "type": ["boolean", "null"] },
            "chain_id": { "type": "integer", "minimum": 1 },
            "filters": {
              "type": "object",
              "required": ["tag_id", "max_spread", "min_liquidity", "min_volume24h", "require_fee_enabled", "require_orderbook", "allowed_slugs", "assets"],
              "properties": {
                "tag_id": { "type": "integer", "minimum": 1 },
                "max_spread": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "min_liquidity": { "type": "number", "minimum": 0 },
                "min_volume24h": { "type": "number", "minimum": 0 },
                "require_fee_enabled": { "type": "boolean" },
                "require_orderbook": { "type": "boolean" },
                "allowed_slugs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "assets": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "coinbase": {
          "type": "object",
          "required": ["api_base", "products", "hedge_threshold_usd", "hedge_max_slippage_bps"],
          "properties": {
            "api_base": { "type": "string", "pattern": "^https?://" },
            "api_key": { "type": ["string", "null"] },
            "api_secret": { "type": ["string", "null"] },
            "passphrase": { "type": ["string", "null"] },
            "products": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "hedge_threshold_usd": { "type": "number", "exclusiveMinimum": 0 },
            "hedge_max_slippage_bps": { "type": "number", "minimum": 0 },
            "auth": {
              "type": "object",
              "properties": {
                "active_profile": { "type": "string" },
                "allow_hot_reload": { "type": "boolean" },
                "strict_live_auth": { "type": "boolean" },
                "profiles": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "cdp_key_file": { "type": ["string", "null"] },
                      "cdp_secret_id": { "type": ["string", "null"] },
                      "expected_key_id": { "type": ["string", "null"] },
                      "strategy_tags": { "type": "array", "items": { "type": "string" } }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "ws": {
              "type": "object",
              "properties": {
                "url": { "type": "string", "pattern": "^wss?://" },
                "channels": { "type": "array", "items": { "type": "string" } },
                "heartbeat_timeout_ms": { "type": "integer", "minimum": 1 },
                "resync_on_gap": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "signals": {
      "type": "object",
      "required": ["wallet", "tradingview"],
      "properties": {
        "wallet": {
          "type": "object",
          "required": ["refresh_secs", "top_n", "allowlist_path", "enforce_allowlist"],
          "properties": {
            "refresh_secs": { "type": "integer", "minimum": 1 },
            "top_n": { "type": "integer", "minimum": 1 },
            "allowlist_path": { "type": "string" },
            "enforce_allowlist": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "tradingview": {
          "type": "object",
          "required": ["enabled", "bind_addr", "k_wallet", "k_tv"],
          "properties": {
            "enabled": { "type": "boolean" },
            "bind_addr": { "type": "string" },
            "endpoint_secret": { "type": ["string", "null"] },
            "k_wallet": { "type": "number" },
            "k_tv": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": ["daily_loss_limit_pct", "max_notional_per_market", "max_total_open_notional", "max_markets_quoted_simultaneously", "max_unhedged_delta", "max_order_age_secs", "stale_book_threshold_ms", "min_expected_net"],
      "properties": {
        "daily_loss_limit_pct": { "type": "number", "exclusiveMinimum": 0 },
        "max_notional_per_market": { "type": "number", "exclusiveMinimum": 0 },
        "max_total_open_notional": { "type": "number", "exclusiveMinimum": 0 },
        "max_markets_quoted_simultaneously": { "type": "integer", "minimum": 1 },
        "max_unhedged_delta": { "type": "number", "exclusiveMinimum": 0 },
        "max_order_age_secs": { "type": "integer", "minimum": 1 },
        "stale_book_threshold_ms": { "type": "integer", "minimum": 1 },
        "min_expected_net": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "allow_taker_on_unwind_only": { "type": "boolean" },
        "post_only": { "type": "boolean" },
        "cancel_replace_cooldown_ms": { "type": "integer", "minimum": 1 },
        "min_rest_ms": { "type": "integer", "minimum": 1 },
        "stale_book_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "strategy": {
      "type": "object",
      "properties": {
        "default_strategy_name": { "type": "string" },
        "imbalance_weight": { "type": "number" },
        "momentum_weight": { "type": "number" },
        "volatility_weight": { "type": "number" },
        "plugin_weight": { "type": "number" },
        "score_threshold": { "type": "number" },
        "priority_fill_threshold": { "type": "number" },
        "momentum_window": { "type": "integer", "minimum": 1 },
        "realized_vol_window": { "type": "integer", "minimum": 1 },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id"],
            "properties": {
              "product_id": { "type": "string" },
              "enabled": { "type": "boolean" },
              "live_enabled": { "type": "boolean" },
              "strategy_name": { "type": "string" },
              "quote_size_usd": { "type": "number", "minimum": 0 },
              "score_threshold": { "type": "number" },
              "plugin_signal": { "type": "number" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "scanner": {
      "type": "object",
      "properties": {
        "max_products": { "type": "integer", "minimum": 1 },
        "top_n": { "type": "integer", "minimum": 1 },
        "quote_currencies": { "type": "array", "items": { "type": "string" } },
        "include_derivatives": { "type": "boolean" },
        "refresh_ms": { "type": "integer", "minimum": 250 },
        "product_refresh_secs": { "type": "integer", "minimum": 1 },
        "candle_granularity_sec": { "type": "integer", "minimum": 1 },
        "candle_limit": { "type": "integer", "minimum": 1 },
        "trade_limit": { "type": "integer", "minimum": 1 },
        "book_levels": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "properties": {
        "mode_default": { "type": "string" },
        "scanner_limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "live_arming": {
      "type": "object",
      "properties": {
        "require_manual_arm": { "type": "boolean" },
        "taker_budget_usd": { "type": "number", "minimum": 0 },
        "one_way_confirmation_ticks": { "type": "integer", "minimum": 1 },
        "auto_disarm_reject_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "auto_disarm_stale_data_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "required": ["sqlite_path", "parquet_dir", "snapshot_roll_secs"],
      "properties": {
        "sqlite_path": { "type": "string" },
        "parquet_dir": { "type": "string" },
        "snapshot_roll_secs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "ops": {
      "type": "object",
      "required": ["log_level", "dashboard_bind", "metrics_flush_secs", "market_refresh_secs", "wallet_refresh_secs", "risk_watchdog_ms"],
      "properties": {
        "log_level": { "type": "string" },
        "dashboard_bind": { "type": "string" },
        "metrics_flush_secs": { "type": "integer", "minimum": 1 },
        "market_refresh_secs": { "type": "integer", "minimum": 1 },
        "wallet_refresh_secs": { "type": "integer", "minimum": 1 },
        "risk_watchdog_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
