{
  "include_globs": [
    "AGENTS.md",
    ".cursor/rules/**",
    "README.md",
    "CONTRIBUTING.md",
    "DEPLOYMENT.md",
    "Cargo.toml",
    "Cargo.lock",
    "crates/**",
    "scripts/**",
    "tools/**",
    "config/**",
    "schemas/**",
    "docs/**",
    "pine-scripts/**",
    ".github/workflows/**"
  ],
  "exclude_globs": [
    ".git/**",
    "target/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".venv/**",
    "venv/**",
    "__pycache__/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    "artifacts/**",
    "data/output/**",
    "data/strategy_lab/**",
    "data/replay/**",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.pdf",
    "*.zip",
    "*.gz",
    "*.tar",
    "*.7z",
    "*.woff",
    "*.woff2",
    "*.ttf",
    "*.otf",
    "*.db",
    "*.sqlite"
  ],
  "max_file_bytes": 300000,
  "max_total_bytes": 10000000,
  "collapse_blank_runs": true
}
